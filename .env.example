# Opslag: Neon Postgres. Zonder DATABASE_URL blijft de data alleen in het geheugen van het proces (verloren bij herstart).
DATABASE_URL="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# AI (optioneel): Claude voor samenvattingen van kandidaten, projectextractie uit documenten en factor-extractie uit websites.
# Zonder sleutel werkt alles op regels. Er gaan alleen openbare bedrijfs- en projectteksten naar het model, nooit contactpersonen.
ANTHROPIC_API_KEY=""

# Discovery (optioneel): KVK Zoeken API (developers.kvk.nl). Zonder sleutel werkt alleen de keyless webzoek-connector.
KVK_API_KEY=""

# Geheim voor de periodieke verrijkingsroute (POST /api/verrijking/run met header x-cron-secret).
CRON_SECRET=""

# Zet op 1 om met fictieve demodata te starten (alleen voor demonstraties). Standaard start de database leeg.
DEMO_DATA=""

# Bestandsuploads bij partnerdocumenten (Vercel Blob). Op Vercel: koppel een Blob-store aan het project,
# dan staat deze variabele er automatisch. Zonder token blijven URL/tekst-documenten gewoon werken.
BLOB_READ_WRITE_TOKEN=""

NEXT_PUBLIC_APP_NAME="Blauwhoed Partnerdatabase"
