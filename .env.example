# Opslag: Neon Postgres. Zonder DATABASE_URL blijft de data alleen in het geheugen van het proces (verloren bij herstart).
DATABASE_URL="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# AI (optioneel): Claude voor samenvattingen van kandidaten, projectextractie uit documenten en factor-extractie uit websites.
# Zonder sleutel werkt alles op regels. Er gaan alleen openbare bedrijfs- en projectteksten naar het model, nooit contactpersonen.
ANTHROPIC_API_KEY=""

# KVK API-sleutel van Blauwhoed (developers.kvk.nl): Zoeken API (discovery, aandragen) en Basisprofiel (verrijking, US-60).
# Zonder sleutel werkt alles zoals voorheen en toont de UI dat de KVK-koppeling niet actief is.
KVK_API_KEY=""

# Geheim voor de periodieke verrijkingsroute (Vercel Cron: Authorization: Bearer $CRON_SECRET; handmatig: header x-cron-secret).
# Verplicht in productie.
CRON_SECRET=""

# Inloggen (US-64): Auth.js met Microsoft Entra ID. Zonder deze waarden is de app in productie dicht.
AUTH_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0/"
# Toegestane e-maildomeinen (kommagescheiden) en het e-mailadres van de eerste beheerder.
AUTH_TOEGESTANE_DOMEINEN="blauwhoed.nl"
EERSTE_BEHEERDER_EMAIL=""
# Alleen voor demo's: 1 = app open zonder inloggen, met rolwisselaar. Nooit in productie gebruiken.
AUTH_DEMO_MODUS=""

# Zet op 1 om met fictieve demodata te starten (alleen voor demonstraties). Standaard start de database leeg.
DEMO_DATA=""

# Bestandsuploads bij partnerdocumenten (Vercel Blob). Op Vercel: koppel een Blob-store aan het project,
# dan staat deze variabele er automatisch. Zonder token blijven URL/tekst-documenten gewoon werken.
BLOB_READ_WRITE_TOKEN=""

NEXT_PUBLIC_APP_NAME="Blauwhoed Partnerdatabase"
